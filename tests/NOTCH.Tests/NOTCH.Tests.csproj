    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\NOTCH\ModEntry.cs" />
    <Compile Include="..\..\src\NOTCH\WireMod.cs" />
    <Compile Include="..\..\src\NOTCH\ModCompare.cs" />
    <Compile Include="..\..\src\NOTCH\PlayerNote.cs" />
    <Compile Include="..\..\src\NOTCH\CheckReport.cs" />
