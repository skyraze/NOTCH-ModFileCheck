    <Compile Include="..\..\src\NOTCH\Panel\PanelData.cs" />
    <Compile Include="..\..\src\NOTCH\Admin\AdminList.cs" />
    <Compile Include="..\..\src\NOTCH\Catalogue\CatalogueGate.cs" />
    <Compile Include="..\..\src\NOTCH\Catalogue\CatalogueData.cs" />
    <Compile Include="..\..\src\NOTCH\Catalogue\CatalogueCheck.cs" />
    <Compile Include="..\..\src\NOTCH\Catalogue\CatalogueMatch.cs" />
    <Compile Include="..\..\src\NOTCH\Consent\ConsentState.cs" />
    <Compile Include="..\..\src\NOTCH\Consent\Agreement.cs" />
    <Compile Include="..\..\src\NOTCH\Consent\AgreementText.cs" />
    <Compile Include="..\..\src\NOTCH\Sync\ConfigPack.cs" />
    <Compile Include="..\..\src\NOTCH\Sync\SyncRules.cs" />
    <Compile Include="..\..\src\NOTCH\Sync\RevertGuard.cs" />
    <Compile Include="..\..\src\NOTCH\Sync\StopLog.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Same major version as the copy the game ships (13.0). -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.*" />
  </ItemGroup>
</Project>
